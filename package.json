{
  "name": "bodytrace",
  "version": "0.1.0",
  "description": "Interactive health intelligence platform for tracking and analyzing pain symptoms",
  "private": true,
  "type": "module",
  "author": "BodyTrace Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/learnermaker/bodytrace.git"
  },
  "bugs": {
    "url": "https://github.com/learnermaker/bodytrace/issues"
  },
  "homepage": "https://github.com/learnermaker/bodytrace#readme",
  "keywords": [
    "health",
    "pain-tracking",
    "symptom-tracker",
    "healthcare",
    "3d-visualization",
    "react",
